# Choose either Gemini or OpenAI (or both, Gemini will be prioritized if both are present)

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI / Compatible Configuration (e.g. OpenAI, Groq, OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here
